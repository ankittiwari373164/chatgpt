# ─── Server ──────────────────────────────────────────────────
PORT=3000

# Token required for admin endpoints (cookie upload, manual cron, etc.)
ADMIN_TOKEN=change-me-to-a-long-random-string

# ─── MongoDB ─────────────────────────────────────────────────
# Free M0 cluster: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://chatgpt:chatgpt2023@chatgpt.yrnrr0m.mongodb.net/?appName=chatgpt

# ─── Groq (captions + prompts) ───────────────────────────────
# Get free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# ─── Cloudinary (image hosting for Meta) ─────────────────────
# Get free creds at https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Meta (Facebook + Instagram) ─────────────────────────────
# Get a long-lived user access token from Graph API Explorer:
# https://developers.facebook.com/tools/explorer/
# Scopes: pages_show_list, pages_manage_posts, pages_read_engagement,
#         instagram_basic, instagram_content_publish, business_management
META_ACCESS_TOKEN=

# ─── Image generation behaviour ──────────────────────────────
# Set to "false" to disable the Pollinations.ai fallback (then
# Puppeteer-via-ChatGPT must succeed or the post is skipped).
IMAGE_FALLBACK_ENABLED=true

# Override Chromium binary location (local dev only)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
